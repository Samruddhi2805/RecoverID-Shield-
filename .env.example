# ==========================================
# RecoverID Shield Environment Configuration
# ==========================================

# Blockchain RPC & Network
ANVIL_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
SEPOLIA_CHAIN_ID=11155111

# Deployer Private Key (Local Anvil Account #0 by default)
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
SEPOLIA_DEPLOYER_PRIVATE_KEY=

# Deployed Contract Addresses (Populated automatically after deployment)
VITE_RPC_URL=http://127.0.0.1:8545
VITE_CHAIN_ID=31337
VITE_FACTORY_ADDRESS=
VITE_RECOVERY_MODULE_ADDRESS=
VITE_MOCK_ERC20_ADDRESS=
VITE_API_BASE_URL=http://localhost:4000

# Backend API Configuration
PORT=4000
DATABASE_PATH=./data/recoverid.sqlite
CORS_ORIGIN=http://localhost:5173

# Email Notification Provider (mock | smtp | resend)
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notifications@recoverid.shield
RESEND_API_KEY=

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SECURITY_TOKEN_SALT=shield-local-secret-salt
